{
    "compilerOptions": {
      "target": "es2022",
      "module": "esnext",
      "moduleResolution": "node",
      "lib": ["es2022", "dom"],
      "allowJs": true,
      "declaration": true,
      "declarationMap": true,
      "stripInternal": true,
      "sourceMap": true,
      "outDir": "dist",
      "rootDir": "./src",
      "alwaysStrict": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "noImplicitAny": false,
      "noImplicitThis": true,
      "strictBindCallApply": true,
      "strictFunctionTypes": true,
      "resolveJsonModule": true,
      "noImplicitOverride": true,
      "noImplicitReturns": true,
      "skipLibCheck": true,
      "baseUrl": "./src",
      "paths": {
        "~/*": ["*"],
      }
    },
    "exclude": [
      "node_modules",
      "**/*.test.ts",
      "**/*.spec.ts"
    ]
  }