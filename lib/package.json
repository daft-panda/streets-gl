{
    "name": "streets-gl-lib",
    "version": "1.0.0",
    "description": "OpenStreetMap 3D renderer core library",
    "author": "StrandedKitty",
    "license": "MIT",
    "type": "module",
    "main": "dist/lib/src/index.js",
    "module": "dist/lib/src/index.js",
    "types": "dist/lib/src/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/lib/src/index.js",
            "types": "./dist/lib/src/index.d.ts"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/StrandedKitty/streets-gl.git"
    },
    "scripts": {
        "build": "rollup -c",
        "build:prod": "rollup -c --environment BUILD:production",
        "typecheck": "tsc --noEmit -p ./tsconfig.json",
        "declaration": "tsc -p ./tsconfig.json --declaration --emitDeclarationOnly",
        "postinstall": "rollup -c",
        "preinstall": "echo 'This package requires building. Run: bun pm trust streets-gl-lib'"
    },
    "dependencies": {
        "@loaders.gl/core": "^3.4.15",
        "@loaders.gl/gltf": "^3.4.15",
        "astronomy-bundle": "^7.7.7",
        "d3": "^7.9.0",
        "dagre": "^0.8.5",
        "dagre-d3": "^0.6.4",
        "earcut": "^2.2.4",
        "lerc": "^4.0.4",
        "path-browserify": "^1.0.1",
        "pbf": "^3.3.0",
        "polybooljs": "^1.2.2",
        "polylabel": "^1.1.0",
        "rbush": "^3.0.1",
        "simplify-js": "^1.2.4",
        "straight-skeleton": "^2.0.1",
        "suncalc": "^1.9.0",
        "url": "^0.11.4"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^11.1.6",
        "@types/d3": "^7.4.3",
        "@types/dagre": "^0.7.52",
        "@types/dagre-d3": "^0.6.6",
        "@types/earcut": "^2.1.4",
        "@types/geojson": "^7946.0.16",
        "@types/jest": "^26.0.24",
        "@types/node": "^14.18.63",
        "@types/pbf": "^3.0.5",
        "@types/polylabel": "^1.1.3",
        "@types/rbush": "^3.0.4",
        "@types/suncalc": "^1.9.2",
        "@types/webpack-env": "^1.18.8",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "concurrently": "^5.3.0",
        "eslint": "^8.57.1",
        "eslint-webpack-plugin": "^3.2.0",
        "html-webpack-plugin": "^5.6.3",
        "http-server": "^14.1.1",
        "jest": "^29.7.0",
        "jest-mock-extended": "^3.0.7",
        "rollup": "^4.12.0",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-glsl": "^1.3.0",
        "rollup-plugin-web-worker-loader": "^1.7.0",
        "ts-node": "^10.9.2",
        "typescript": "^4.9.5"
    },
    "peerDependencies": {},
    "sideEffects": false
}