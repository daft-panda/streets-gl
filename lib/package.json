{
    "name": "streets-gl-lib",
    "version": "1.0.0",
    "description": "OpenStreetMap 3D renderer core library",
    "author": "StrandedKitty",
    "license": "MIT",
    "type": "module",
    "main": "dist/src/index.js",
    "module": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/src/index.js",
            "types": "./dist/src/index.d.ts"
        },
        "./*": "./dist/*"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/StrandedKitty/streets-gl.git"
    },
    "scripts": {
        "build": "rollup -c",
        "build:prod": "rollup -c --environment BUILD:production",
        "typecheck": "tsc --noEmit -p ./tsconfig.json",
        "declaration": "tsc -p ./tsconfig.json --declaration --emitDeclarationOnly",
        "prepare": "test -d node_modules || bun install && rollup -c",
        "preinstall": "echo 'This package requires building. Run: bun pm trust streets-gl-lib'"
    },
    "dependencies": {
        "@loaders.gl/core": "^4.3.4",
        "@loaders.gl/gltf": "^4.3.4",
        "astronomy-bundle": "^7.7.7",
        "d3": "^7.9.0",
        "dagre": "^0.8.5",
        "dagre-d3": "^0.6.4",
        "earcut": "^3.0.1",
        "lerc": "^4.0.4",
        "path-browserify": "^1.0.1",
        "pbf": "^4.0.1",
        "polybooljs": "^1.2.2",
        "polylabel": "^2.0.1",
        "rbush": "^4.0.1",
        "simplify-js": "^1.2.4",
        "straight-skeleton": "^2.0.1",
        "suncalc": "^1.9.0",
        "url": "^0.11.4"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.30.1",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.4",
        "@types/d3": "^7.4.3",
        "@types/dagre": "^0.7.53",
        "@types/dagre-d3": "^0.6.6",
        "@types/earcut": "^3.0.0",
        "@types/geojson": "^7946.0.16",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.10",
        "@types/pbf": "^3.0.5",
        "@types/polylabel": "^1.1.3",
        "@types/rbush": "^4.0.0",
        "@types/suncalc": "^1.9.2",
        "@types/webpack-env": "^1.18.8",
        "@typescript-eslint/eslint-plugin": "^8.35.1",
        "@typescript-eslint/parser": "^8.35.1",
        "concurrently": "^9.2.0",
        "eslint": "^9.30.1",
        "eslint-webpack-plugin": "^5.0.2",
        "globals": "^16.3.0",
        "html-webpack-plugin": "^5.6.3",
        "http-server": "^14.1.1",
        "jest": "^30.0.3",
        "jest-mock-extended": "^4.0.0",
        "rollup": "^4.44.1",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-glsl": "^1.3.0",
        "rollup-plugin-web-worker-loader": "^1.7.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "peerDependencies": {},
    "sideEffects": false
}